---
import TopologyRig from '@/components/TopologyRig.astro';

const storyBeats = [
  {
    title: 'Turn incidents into evidence.',
    body: 'Self-hosted AcornOps investigates incidents, then turns operational intent into governed Workflows run by the right Agents. Every answer, action, and handoff stays inspectable.'
  },
  {
    title: 'A workload fails.',
    body: 'Here, a payments pod stops serving traffic. AcornOps separates the incident from the surrounding noise.'
  },
  {
    title: 'The right person knows.',
    body: 'The alert carries the affected system and the signal that matters, so your team starts with context instead of a wall of symptoms.'
  },
  {
    title: 'You choose triage.',
    body: 'One deliberate action begins the investigation. AcornOps can move quickly without taking control away from the operator.'
  },
  {
    title: 'The assistant gathers what the job needs.',
    body: 'It discovers the available MCP servers, skills, and tools, then follows the evidence across your environment.'
  },
  {
    title: 'The cause comes with receipts.',
    body: 'You get a plain-language answer, the supporting evidence, and a durable run record your team can inspect later.'
  }
] as const;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__stage" data-hero-stage>
    <div class="hero__content shell">
      <h1 id="hero-title" data-hero-reveal>
        {storyBeats.map((beat, index) => (
          <span
            class="hero__title-beat"
            data-hero-story-title
            data-active={index === 0 ? 'true' : 'false'}
            aria-hidden={index === 0 ? undefined : 'true'}
          >
            {beat.title}
          </span>
        ))}
      </h1>
      <div class="hero__story" data-hero-story data-hero-reveal>
        {storyBeats.map((beat, index) => (
          <div
            class="hero__beat"
            data-hero-story-beat
            data-active={index === 0 ? 'true' : 'false'}
            aria-hidden={index === 0 ? undefined : 'true'}
          >
            <p>{beat.body}</p>
          </div>
        ))}
      </div>
      <div class="hero__actions" data-hero-reveal>
        <a class="button button--primary" href="https://console.demo.acornops.dev/" data-brand-contrast-exception="activation" data-track-cta-location="hero" data-track-cta-destination="demo">
          Try the demo <span aria-hidden="true">↗</span>
        </a>
        <a class="button button--secondary" href="https://docs.acornops.dev/" data-track-cta-location="hero" data-track-cta-destination="docs">
          Read the docs <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
    <TopologyRig />
  </div>
</section>
